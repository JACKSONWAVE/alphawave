{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/feishu-cron?type=morning",
      "schedule": "0 1 * * 1-5"
    },
    {
      "path": "/api/intel-cron",
      "schedule": "0 0,1,2,3,5,7,9 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/analysis", "destination": "/index.html" },
    { "source": "/watchlist", "destination": "/index.html" },
    { "source": "/screener", "destination": "/index.html" },
    { "source": "/trades", "destination": "/index.html" },
    { "source": "/feishu", "destination": "/index.html" },
    { "source": "/alerts", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}
